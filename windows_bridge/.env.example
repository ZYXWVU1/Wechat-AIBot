# These values are Windows user environment variables, not a file that bridge.py loads.
WCF_BRIDGE_KEY=generate-a-random-value-do-not-commit-it
WCF_BRIDGE_HOST=192.168.1.120
WCF_BRIDGE_PORT=8787
WCF_ALLOWED_RECEIVERS=filehelper
WCF_DATA_DIR=C:\WCF-Bridge\data
WCF_EVENT_RETENTION_DAYS=7
WCF_MIN_SEND_INTERVAL_SECONDS=2.0

