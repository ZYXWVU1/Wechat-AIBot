# Required bridge connection
BRIDGE_URL=http://192.168.1.120:8787
BRIDGE_KEY=replace-with-the-same-random-key-as-windows

# Safety switches: all three must be deliberately configured before messages send.
AUTO_REPLY_ENABLED=false
DRY_RUN=true
DIRECT_REPLY_ENABLED=false
GROUP_REPLY_ENABLED=false

# Explicit WeChat IDs only. Empty means nobody/no group is eligible.
ALLOWED_DIRECT_SENDERS=
ALLOWED_GROUPS=

# Generic OpenAI-compatible Chat Completions endpoint.
# Keep AI_PROVIDER=disabled until the bridge and policy tests pass.
AI_PROVIDER=disabled
AI_CHAT_COMPLETIONS_URL=
AI_API_KEY=
AI_MODEL=
AI_ENABLE_THINKING=
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=300

# Persona and disclosure
PERSONA_FILE=/config/persona.txt
DISCLOSURE_PREFIX=🤖 
MAX_CONTEXT_MESSAGES=20
MAX_REPLY_CHARS=360
MAX_CHUNK_CHARS=120
MAX_CHUNKS=3

# Persistent scheduling; no reply path calls sleep for human-like delays.
READ_DELAY_MIN_SECONDS=3
READ_DELAY_MAX_SECONDS=7
TYPING_SECONDS_PER_CHARACTER=0.12
CHUNK_GAP_MIN_SECONDS=1
CHUNK_GAP_MAX_SECONDS=3
REPLY_PROBABILITY=1.0

# Runtime
DATABASE_PATH=/data/bot.db
POLL_INTERVAL_SECONDS=1
OUTBOX_POLL_SECONDS=0.5
MAX_SEND_ATTEMPTS=5
LOG_LEVEL=INFO
